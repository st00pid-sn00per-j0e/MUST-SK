<Window x:Class="AgentClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV People Ops Helpers" Height="820" Width="1120"
        MinHeight="650" MinWidth="850"
        Background="#F3F4F6" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CSV People Ops Helpers" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                <TextBlock Text="Small, focused helpers for inbox, attendance, and hiring-board CSVs."
                           Foreground="#6B7280" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Status, StringFormat='Status: {0}'}"
                       VerticalAlignment="Center" Foreground="#4B5563" FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1" Background="White" Padding="18" CornerRadius="8"
                BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="Choose a helper" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}"
                              DisplayMemberPath="Name" Padding="8" FontSize="14">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Text="{Binding SelectedWorkflow.Description}" Foreground="#374151" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding SelectedWorkflow.CsvSchema}" Foreground="#6B7280" FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Choose CSV…" Command="{Binding PickFileCommand}" Margin="0,0,8,0" />
                    <Button Content="Use sample data" Command="{Binding UseSampleCommand}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SelectedFilePath}" VerticalAlignment="Center" Foreground="#4B5563"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Stale after days (stall alerter only)" VerticalAlignment="Center"
                               Foreground="#4B5563" Margin="0,0,8,0" />
                    <TextBox Text="{Binding ThresholdDays, UpdateSourceTrigger=PropertyChanged}"
                             Width="64" Padding="6" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedWorkflow.Id}" Value="stalls">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="12,12,0,0">
                    <Button Content="Cancel" Command="{Binding CancelRunCommand}" Margin="0,0,8,0" />
                    <Button Content="Analyze CSV" Command="{Binding StartRunCommand}"
                            Background="#047857" Foreground="White" BorderThickness="0" FontWeight="Bold" />
                    <Button Content="Save output CSV…" Command="{Binding DownloadOutputCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="5" Maximum="100"
                             Value="{Binding UploadProgress}" Margin="0,14,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" Padding="16" CornerRadius="8"
                BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Result preview — you can edit cells before saving"
                           Style="{StaticResource SectionTitle}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding OutputRows}" AutoGenerateColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          RowBackground="White" AlternatingRowBackground="#F9FAFB"
                          BorderBrush="#E5E7EB" />
                <TextBlock Grid.Row="2" Text="Inbox drafts are suggestions only. Review and edit every draft before using it; this app cannot send messages."
                           Foreground="#92400E" Background="#FFFBEB" Padding="8" Margin="0,10,0,0"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedWorkflow.Id}" Value="inbox">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" Padding="16" CornerRadius="8"
                BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Run activity" Style="{StaticResource SectionTitle}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2"
                                           Foreground="#4B5563" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1"
                Padding="10" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
